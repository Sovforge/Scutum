# Version control
.git
.gitignore

# CI / docs
*.md
LICENSE
scripts/

# Local dev
.env
.env.*
.vscode/
.idea/
.DS_Store
Thumbs.db

# Runtime dirs (built inside container)
data/
secrets/
scutum/
coverage.out

# Build artifacts
scutum.tar.gz
docker-run.txt

# Compiled binaries (built inside Docker)
api
sovran
tests.test
*.test
*.out

# Test files (not needed for build)
cmd/tests/

# Frontend — the Docker build runs its own `npm ci` in a clean stage; a
# host-local frontend/node_modules or frontend/dist would otherwise get
# copied in by `COPY frontend/ ./` and could clobber that fresh install
# with mismatched-platform binaries.
frontend/node_modules/
frontend/dist/
